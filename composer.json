{
    "name": "bsiradze/bitrix24-call-sync",
    "description": "Logs calls from any SIP PBX into Bitrix24 CRM through the REST API (telephony.externalcall.*).",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": ">=8.1",
        "ext-curl": "*",
        "ext-json": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5"
    },
    "autoload": {
        "psr-4": { "CallSync\\": "src/" }
    },
    "autoload-dev": {
        "psr-4": { "CallSync\\Tests\\": "tests/" }
    },
    "scripts": {
        "test": "phpunit"
    }
}
