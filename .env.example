# Incoming webhook from Bitrix24 (Developer resources > Other > Inbound webhook)
# Required scopes: telephony, crm, user
B24_WEBHOOK_URL=https://your-portal.bitrix24.com/rest/1/xxxxxxxxxxxxxxxx/
# Shared secret the PBX sends in the X-Webhook-Secret header
PBX_WEBHOOK_SECRET=change-me
# Default country code for local numbers (Georgia = 995)
DEFAULT_COUNTRY_CODE=995
# Bitrix24 user who gets calls with no extension (IVR hang-ups, queue timeouts)
B24_FALLBACK_USER_ID=1
